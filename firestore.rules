rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Waypoints collection - public read, no public write
    match /waypoints/{waypointId} {
      allow read: if true;  // Anyone can read waypoints
      allow write: if false; // No one can write (only admin via server)
    }
    
    // User preferences collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Settings collection - users can only access their own settings
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Analytics collection - read-only for authenticated users
    match /analytics/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server can write analytics
    }
    
    // Default rule - deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 